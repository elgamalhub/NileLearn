# Copy to .env (or set as environment variables) and fill in real values.
# The checked-in appsettings.json only contains clearly-labelled development placeholders.

# Database. Leave UseSqlite=true to use the embedded SQLite database.
USESQLITE=true
# Used when USESQLITE=false
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost,1433;Database=NileLearnDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True

# JWT signing key. Must be at least 32 characters.
JWT__SECRETKEY=replace-with-a-long-random-secret-at-least-32-chars

# Payment gateways (server-side only; never expose these in the browser)
PAYMENTGATEWAYS__PAYMOB__APIKEY=
PAYMENTGATEWAYS__PAYMOB__HMACSECRET=
PAYMENTGATEWAYS__PAYMOB__CARDINTEGRATIONID=
PAYMENTGATEWAYS__PAYMOB__WALLETINTEGRATIONID=
PAYMENTGATEWAYS__FAWRY__SECURITYKEY=
PAYMENTGATEWAYS__FAWRY__MERCHANTCODE=
PAYMENTGATEWAYS__KASHIER__MERCHANTID=
PAYMENTGATEWAYS__KASHIER__APIKEY=
PAYMENTGATEWAYS__STRIPE__PUBLISHABLEKEY=
PAYMENTGATEWAYS__STRIPE__SECRETKEY=
PAYMENTGATEWAYS__STRIPE__WEBHOOKSECRET=

# Storage
STORAGE__UPLOADPATH=AppData/Uploads
